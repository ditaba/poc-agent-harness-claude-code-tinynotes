BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# Optional locally: without it the app uses the SQLite file data/app.db.
# On Vercel, set your Turso database URL (libsql://<db>-<org>.turso.io) and a token from
# `turso db tokens create <db>`.
TURSO_DATABASE_URL=file:data/app.db
TURSO_AUTH_TOKEN=
